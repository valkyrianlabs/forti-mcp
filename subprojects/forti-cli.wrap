# forti-cli provides forti-engine, the command engine forti-mcp links statically. Only the engine
# is built when forti-cli is a subproject. For co-development, replace subprojects/forti-cli with a
# checkout or a symlink to ../forti-cli; Meson then uses it instead of downloading.
[wrap-git]
url = https://github.com/valkyrianlabs/forti-cli.git
# Pinned to a forti-cli commit until forti-cli has a release tag.
revision = a0456f1ca7d81a6f69bbac2b56aa39491d36aaa0
depth = 1

[provide]
forti-engine = forti_engine_dep
