#!/usr/bin/make -f
# forti-mcp against the system forti-api (libforti-api-dev), with the engine compiled from
# subprojects/forti-cli: forti-cli at exactly the revision subprojects/forti-cli.wrap pins, put there and
# verified by `packaging/forti-cli-pin.sh vendor` before the build (release.toml debian.pre_build).
# --wrap-mode=nodownload keeps the build offline: a missing engine source, or a missing or too-old
# libforti-api-dev, fails the build instead of fetching anything (the forti-api wrap is never used).
#
# Release profile (.claude/context/release.md, "Build profile"), as in forti-cli: debhelper configures
# meson with buildtype=plain and dpkg-buildflags (hardening on), so meson.build's release optimization
# (-O3) is applied here in place of dpkg's -O2, and NDEBUG explicitly
# (b_ndebug=if-release does not fire for buildtype=plain). meson.build adds -ffunction-sections
# -fdata-sections -Wl,--gc-sections for non-debug ELF builds. debhelper strips it; no -dbgsym package ships.

# Ubuntu's dpkg defaults add -flto=auto -ffat-lto-objects and -g. Neither is needed (fat LTO compiles
# everything twice and re-optimizes the whole program at link), and the binary is stripped with no
# debug package shipped, so both
# are off: -O3 as built is what is tested.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=-lto
export DEB_CXXFLAGS_MAINT_STRIP = -O2 -g
export DEB_CXXFLAGS_MAINT_APPEND = -O3

include /usr/share/dpkg/architecture.mk

%:
	dh $@ --buildsystem=meson

# forti-cli:subproject_cli=false: the package needs no `forti` executable (only the integration suite
# drives it, and that suite does not run here).
override_dh_auto_configure:
	dh_auto_configure -- --wrap-mode=nodownload -Db_ndebug=true -Dforti-cli:subproject_cli=false \
		-Dtests=$(if $(filter nocheck,$(DEB_BUILD_OPTIONS) $(DEB_BUILD_PROFILES)),disabled,enabled)

# The network-free suites: unit (GoogleTest over the protocol and tools) and e2e (spawns the built
# binary with temporary config, state and cache directories). The integration suite (forti-mcp and
# forti against forti-cli's mock FortiOS over loopback TLS; python3, openssl and the forti executable)
# runs in CI on every change instead.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	meson test -C obj-$(DEB_HOST_GNU_TYPE) --suite unit --suite e2e --print-errorlogs
endif

# No -dbgsym package: the build has no debug info (-g is stripped above), so it would be empty.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
